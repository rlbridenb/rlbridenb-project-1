{
  "name": "plane-app",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run angular\" \"npm run electron\"",
    "angular": "cd angular && npm start",
    "electron": "wait-on http://localhost:4200 && electron ."
