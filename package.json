  "private": true,
  "packageManager": "npm@10.9.0",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^44.4.1",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
